import os

lista_produtos = []

while True:
    print('''
=== MERCADINHO DENDEZEIROS ===
1- Cadastrar produtos
2- Listar produtos
0- Sair
''')
    
    try:
        opcao = int(input('Escolha uma opção: '))
    except ValueError:
        print('Opção inválida! Digite apenas números.')
        input('\nPressione uma tecla para continuar...')
        continue

    match opcao:
        case 1:
            print('\n== CADASTRAR UM PRODUTO ==')
            # Inclusão do () em upper()
            nome = input('Nome do novo produto: ').strip().upper()
            
            # Inserção do else para só adicionar se for válido
            if nome == '':
                print('O nome não pode ficar vazio.')
            elif nome in lista_produtos:
                print(f'{nome} já está cadastrado.')
            else:
                lista_produtos.append(nome)
                print('Produto cadastrado com sucesso!')
            
            input('\nPressione uma tecla para continuar...')
            
        case 2:
            print('\n== PRODUTOS NO ESTOQUE ==')
            # Verificação de lista vazia
            if not lista_produtos:
                print('Nenhum produto cadastrado no momento.')
            else:
                for i, produto in enumerate(lista_produtos):
                    print(f'{i + 1}. {produto}')
                # Exibição do total fora do laço for
                print(f'\nTotal de produtos: {len(lista_produtos)}')
            
            input('\nPressione uma tecla para continuar...')
            
        case 0:
            print('Fim do programa.')
            break
        
        case _:
            print('Opção Inválida!')
            input('\nPressione uma tecla para continuar...')